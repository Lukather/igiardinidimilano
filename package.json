{
  "name": "igiardinidimilano",
  "version": "1.0.0",
  "description": "I Giardini di Milano - Foto degli spazi verdi di Milano",
  "type": "module",
  "scripts": {
    "ingest": "tsx src/scripts/ingest.ts",
    "build:data": "tsx src/scripts/build.ts",
    "build:site": "vite build",
    "build": "npm run build:data && npm run build:site",
    "admin": "tsx src/admin/admin-server.mjs",
    "admin:dev": "tsx src/admin/admin-server.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:form": "vite build --config form/vite.config.ts",
    "dev:form": "wrangler dev --cwd form",
    "test:form": "vitest run --config form/vitest.config.ts",
    "typecheck:form": "tsc -p form/tsconfig.json && tsc -p form/tsconfig.browser.json",
    "deploy:form": "wrangler deploy --cwd form"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/busboy": "^1.5.3",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.10.0",
    "exifreader": "^4.11.0",
    "happy-dom": "^21.0.4",
    "miniflare": "^4.20260730.0",
    "sharp": "^0.33.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.1.0",
    "wrangler": "^4.158.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
